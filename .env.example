# Required in Vercel Production, Preview, and Development environments.
# Signs the stateless OTP token (see src/lib/otpStore.ts) - no external
# database or Redis needed. Generate with: openssl rand -hex 32
OTP_SECRET=replace-with-a-long-random-secret

# SMTP credentials from your email provider. Gmail requires an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM="WMA Platform" <your-email@example.com>
